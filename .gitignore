# Sauvegardes automatiques de Blender
*.blend1
*.blend2
*.blend@

# Rendus et vidéos : ils vont sur le Drive, pas dans Git
renders/
*.mp4
*.mov
*.mkv
*.png.tmp

# Secrets : jamais dans Git
.env
.env.*
*.key
credentials*.json
token*.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Systèmes et éditeurs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Réglages Claude Code personnels (les réglages partagés restent versionnés)
.claude/settings.local.json

# HDRI : retéléchargeables avec engine/pipeline/sources_assets.py (lourdes)
engine/assets/hdri/*.hdr
# Modèles et textures téléchargés : retéléchargeables avec engine/pipeline/sources_assets.py (registre et licences, eux, sont versionnés)
engine/assets/modeles/
engine/assets/textures/

# Sons téléchargés (Kenney, CC0) : retéléchargeables avec python -m engine.pipeline.sons telecharger
engine/assets/sons/kenney/
# Sons Freesound téléchargés : retéléchargeables avec python -m engine.pipeline.sources_sons telecharger
engine/assets/sons/freesound/
