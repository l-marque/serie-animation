        "camera": "revelation",
        "cible": "rep_centre",
        "distance": 60,
        "hauteur": 16,
        "focale": 20
      },
      "texte_ecran": "IL RESTE *7* JOURS"
    },
    {
      "id": "b05",
      "voix": "Car au septième jour, les deux îles s'attaquent, et une seule gagnera !",
