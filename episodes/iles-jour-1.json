  "beats": [
    {
      "id": "b01",
      "voix": "Alerte ! Dans sept jours, une de ces deux îles sera rayée de la carte !",
      "plan": {
        "camera": "dolly_avant",
        "cible": "rep_centre",
        "distance": 60,
        "hauteur": 14,
        "focale": 20
      },
      "texte_ecran": "!ALERTE !"
    },
    {
      "id": "b02",
      "voix": "À gauche, l'île d'Instagram. À droite, l'île de YouTube.",
      "plan": {
        "camera": "survol",
        "cible": "rep_centre",
        "distance": 48,
        "hauteur": 10,
        "focale": 22
      }
    },
    {
      "id": "b03",
      "voix": "Pour l'instant, elles sont vides, et c'est vous qui allez les construire.",
      "plan": {
        "camera": "plan_fixe",
        "cible": "rep_insta",
        "distance": 21,
        "hauteur": 4,
        "focale": 24
