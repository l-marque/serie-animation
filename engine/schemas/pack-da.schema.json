{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l-marque/serie-animation/engine/schemas/pack-da.schema.json",
  "title": "Pack de direction artistique",
  "description": "Style exécutable par engine/blender/look.py. Produit par prod-directeur-artistique, validé par un humain.",
  "type": "object",
  "required": [
    "nom",
    "description",
    "version",
    "moteur",
    "monde",
    "soleil",
    "contours",
    "materiaux",
    "texte_ecran",
    "sous_titres"
  ],
  "additionalProperties": false,
  "$defs": {
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "couleur_ass": {
      "type": "string",
      "pattern": "^&H[0-9A-Fa-f]{8}$"
    },
    "moteur": {
      "enum": [
        "BLENDER_EEVEE",
        "CYCLES",
        "BLENDER_WORKBENCH"
      ]
    },
    "materiau": {
      "type": "object",
      "required": [
        "couleur"
      ],
      "additionalProperties": false,
      "properties": {
        "couleur": {
          "$ref": "#/$defs/rgb"
        },
        "rugosite": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emission": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "textures": {
          "type": "string",
          "description": "Dossier de textures PBR (cartes.json), ex. engine/assets/textures/<id> (sources_assets texture)."
        },
        "echelle_texture": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Taille d'une tuile de texture en mètres (défaut 1)."
        },
        "force_teinte": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Part de la couleur du pack mélangée à la texture (0 = texture pure)."
        }
      }
    },
    "texte": {
      "type": "object",
      "required": [
        "police",
        "couleur",
        "contour",
        "taille_relative"
      ],
      "additionalProperties": false,
      "properties": {
        "police": {
          "type": "string",
          "minLength": 1
        },
        "couleur": {
          "$ref": "#/$defs/couleur_ass"
        },
        "contour": {
          "$ref": "#/$defs/couleur_ass"
        },
        "taille_relative": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.12
        },
        "surlignage": {
          "$ref": "#/$defs/couleur_ass",
          "description": "Sous-titres : couleur du mot prononcé (karaoké)."
        },
        "majuscules": {
          "type": "boolean",
          "description": "Sous-titres en capitales (défaut : oui)."
        }
      }
    }
  },
  "properties": {
    "nom": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "version": {
      "type": "string"
    },
    "inspiration": {
      "type": "string",
      "description": "Références et intentions (texte libre, pour les humains)."
    },
    "planche_figma": {
      "type": "string",
      "description": "Lien vers la planche d'ambiance Figma, si elle existe."
    },
    "moteur": {
      "type": "object",
      "required": [
        "final",
        "animatique",
        "secours"
      ],
      "additionalProperties": false,
      "properties": {
        "final": {
          "$ref": "#/$defs/moteur"
        },
        "animatique": {
          "$ref": "#/$defs/moteur"
        },
        "secours": {
          "$ref": "#/$defs/moteur"
        }
      }
    },
    "cycles": {
      "type": "object",
      "properties": {
        "echantillons_final": {
          "type": "integer",
          "minimum": 1
        },
        "echantillons_animatique": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "eevee": {
      "type": "object",
      "properties": {
        "echantillons_final": {
          "type": "integer",
          "minimum": 1
        },
        "echantillons_animatique": {
          "type": "integer",
          "minimum": 1
        },
        "lancer_de_rayons": {
          "type": "boolean",
          "description": "Lumière indirecte et reflets EEVEE (défaut : oui en rendu final, non en animatique)."
        }
      },
      "additionalProperties": false
    },
    "transformation_vue": {
      "enum": [
        "Standard",
        "Filmic",
        "AgX",
        "Khronos PBR Neutral"
      ]
    },
    "exposition": {
      "type": "number",
      "minimum": -5,
      "maximum": 5
    },
    "monde": {
      "type": "object",
      "required": [
        "couleur"
      ],
      "additionalProperties": false,
      "properties": {
        "couleur": {
          "$ref": "#/$defs/rgb"
        },
        "intensite": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "hdri": {
          "type": "string",
          "description": "Chemin relatif au dépôt, ex. engine/assets/hdri/<id>_2k.hdr (Poly Haven)."
        }
      }
    },
    "soleil": {
      "type": "object",
      "required": [
        "rotation_deg"
      ],
      "additionalProperties": false,
      "properties": {
        "rotation_deg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "energie": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "couleur": {
          "$ref": "#/$defs/rgb"
        }
      }
    },
    "ombrage_plat": {
      "type": "boolean"
    },
    "contours": {
      "type": "object",
      "required": [
        "actif"
      ],
      "additionalProperties": false,
      "properties": {
        "actif": {
          "type": "boolean"
        },
        "epaisseur": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "couleur": {
          "$ref": "#/$defs/rgb"
        }
      }
    },
    "materiaux": {
      "type": "object",
      "required": [
        "sol",
        "batiment",
        "toit",
        "vegetation",
        "roche",
        "personnage",
        "accessoire",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "sol": {
          "$ref": "#/$defs/materiau"
        },
        "batiment": {
          "$ref": "#/$defs/materiau"
        },
        "toit": {
          "$ref": "#/$defs/materiau"
        },
        "vegetation": {
          "$ref": "#/$defs/materiau"
        },
        "roche": {
          "$ref": "#/$defs/materiau"
        },
        "personnage": {
          "$ref": "#/$defs/materiau"
        },
        "accessoire": {
          "$ref": "#/$defs/materiau"
        },
        "accent": {
          "$ref": "#/$defs/materiau"
        },
        "eau": {
          "$ref": "#/$defs/materiau"
        }
      }
    },
    "texte_ecran": {
      "$ref": "#/$defs/texte"
    },
    "sous_titres": {
      "$ref": "#/$defs/texte"
    },
    "effets_sonores": {
      "type": "boolean",
      "description": "Pop sur les apparitions et souffle aux changements de plan (défaut : oui)."
    },
    "voix_off": {
      "type": "object",
      "additionalProperties": false,
      "description": "Voix de la série, choisie par un humain après une audition (python -m engine.pipeline.voix audition).",
      "properties": {
        "kyutai": {
          "type": "string",
          "description": "Identifiant d'une voix du dépôt kyutai/tts-voices, ex. cml-tts/fr/<id>_enhanced.wav"
        }
      }
    }
  }
}
