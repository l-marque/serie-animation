{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l-marque/serie-animation/engine/schemas/habillage.schema.json",
  "title": "Habillage d'un épisode (fichier interne au pôle Production)",
  "description": "Fichier facultatif <fiche>.habillage.json posé à côté d'une fiche épisode. Ajoute ce que le contrat v1.0 ne sait pas encore décrire : textes en 3D dans le décor (nom de ville sur un panneau, légendes des cartes de choix) et habillage 2D animé (compteurs, gains « +10 »). Écrit par prod-realisateur ou prod-directeur-artistique ; n'entre pas dans le contrat Storytelling -> Production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "textes_3d": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "texte"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "texte": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "description": "Id d'un élément ou personnage de la fiche. Le texte le suit (position, apparition, disparition). Sans parent, le texte est fixe dans le décor."
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Centre du texte en mètres ; dans le repère du parent s'il y en a un."
          },
          "rotation_z": {
            "type": "number",
            "default": 0,
            "description": "Degrés. 0 = lisible depuis -y (caméra par défaut)."
          },
          "taille": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 20,
            "default": 0.3,
            "description": "Hauteur des lettres en mètres."
          },
          "epaisseur": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.02
          },
          "role": {
            "enum": [
              "sol",
              "batiment",
              "toit",
              "vegetation",
              "roche",
              "personnage",
              "accessoire",
              "accent",
              "eau",
              "peau",
              "tissu",
              "blanc",
              "or",
              "pierre"
            ],
            "default": "accent"
          },
          "visible_au_debut": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "hud": {
      "type": "array",
      "maxItems": 40,
      "description": "Habillage 2D incrusté au montage (style du kit Figma « Outils d'affichage »).",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "beat",
              "valeur"
            ],
            "properties": {
              "type": {
                "const": "compteur"
              },
              "icone": {
                "enum": [
                  "piece",
                  "habitant"
                ],
                "default": "piece"
              },
              "beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "mot": {
                "type": "string",
                "minLength": 1
              },
              "debut": {
                "type": "number",
                "minimum": 0
              },
              "jusqu_au_beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "description": "Dernier beat où le compteur reste affiché (défaut : le beat de départ). Ponctuel ou permanent selon l'histoire : pour un compteur permanent, le dernier beat de l'épisode."
              },
              "valeur": {
                "type": "integer",
                "minimum": 0
              },
              "vers": {
                "type": "integer",
                "minimum": 0,
                "description": "Valeur finale : le compteur défile de « valeur » à « vers »."
              },
              "position": {
                "description": "Où poser le compteur : une ancre (défaut « haut_gauche » ; à droite, l'interface Instagram masque le bas de l'image), ou [x, y] relatifs à l'image (0 à 1) pour son centre. Les compteurs simultanés sur une même ancre s'empilent.",
                "oneOf": [
                  {
                    "enum": [
                      "haut_gauche",
                      "haut_centre",
                      "haut_droite",
                      "bas_gauche",
                      "bas_centre",
                      "bas_droite"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ],
                "default": "haut_gauche"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "beat"
            ],
            "properties": {
              "type": {
                "const": "gain"
              },
              "texte": {
                "type": "string",
                "maxLength": 12,
                "default": "+10"
              },
              "icone": {
                "enum": [
                  "piece",
                  "habitant"
                ],
                "default": "piece"
              },
              "beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "mot": {
                "type": "string",
                "minLength": 1
              },
              "debut": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Centre en fraction de l'image [x, y] (défaut [0,5 ; 0,55])."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "beat",
              "texte"
            ],
            "description": "Badge d'épisode affiché en continu (« JOUR *2* », mot entre astérisques en jaune).",
            "properties": {
              "type": {
                "const": "badge"
              },
              "texte": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "mot": {
                "type": "string",
                "minLength": 1
              },
              "debut": {
                "type": "number",
                "minimum": 0
              },
              "jusqu_au_beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "description": "Dernier beat où le badge reste affiché ; pour un badge permanent, le dernier beat de l'épisode."
              },
              "position": {
                "enum": [
                  "haut_gauche",
                  "haut_centre",
                  "haut_droite",
                  "bas_gauche",
                  "bas_centre",
                  "bas_droite"
                ],
                "default": "haut_droite"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "beat"
            ],
            "description": "Compte à rebours affiché en continu (« 7J 00:00:00 ») qui défile pendant l'épisode.",
            "properties": {
              "type": {
                "const": "chrono"
              },
              "beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "mot": {
                "type": "string",
                "minLength": 1
              },
              "debut": {
                "type": "number",
                "minimum": 0
              },
              "jusqu_au_beat": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "description": "Dernier beat où le badge reste affiché ; pour un badge permanent, le dernier beat de l'épisode."
              },
              "position": {
                "enum": [
                  "haut_gauche",
                  "haut_centre",
                  "haut_droite",
                  "bas_gauche",
                  "bas_centre",
                  "bas_droite"
                ],
                "default": "haut_centre"
              },
              "depart_s": {
                "type": "number",
                "minimum": 0,
                "default": 604800,
                "description": "Valeur de départ en secondes (défaut 7 jours)."
              },
              "vitesse": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 1,
                "description": "Secondes décomptées par seconde de vidéo (1 = temps réel)."
              }
            }
          }
        ]
      }
    },
    "ambiance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "son"
      ],
      "description": "Son de fond sous tout l'épisode (registre engine/assets/sons/registre.json, catégorie ambiance).",
      "properties": {
        "son": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sons": {
      "type": "array",
      "maxItems": 80,
      "description": "Bruitages placés sur un mot ou un instant d'un beat (noms du registre de sons).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "son",
          "beat"
        ],
        "properties": {
          "son": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "beat": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "mot": {
            "type": "string",
            "minLength": 1
          },
          "debut": {
            "type": "number",
            "minimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "repeter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          },
          "intervalle": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5,
            "default": 0.4
          }
        }
      }
    }
  }
}
